# Required
MISTRAL_API_KEY=
TAVILY_API_KEY=

# Required for the API (the CLI runs without it).
# Neon suspends idle branches, so connect_timeout=30 is added automatically.
DATABASE_URL=

# Optional
WRITER_MODEL=mistral-medium-3-5
CRITIC_MODEL=mistral-large-latest
PASS_SCORE=7
MAX_REVISIONS=2
TIME_BUDGET_S=220
CLIENT_HASH_SALT=
