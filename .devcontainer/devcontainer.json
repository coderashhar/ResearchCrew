{
  "name": "ResearchCrew",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md", "docs/ROADMAP-phase1.md"] },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r backend/requirements.txt && npm --prefix frontend ci",
  "portsAttributes": {
    "3000": { "label": "Web", "onAutoForward": "openPreview" },
    "8000": { "label": "API" }
  },
  "forwardPorts": [3000, 8000]
}
